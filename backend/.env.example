# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.

# --- Server -----------------------------------------------------------------
# Port the API listens on. Render injects PORT automatically in production.
PORT=5000
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Local MongoDB example: mongodb://127.0.0.1:27017/cynbit_discovery
# MongoDB Atlas example:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cynbit_discovery?retryWrites=true&w=majority
# Leave empty to boot the API without a database (health endpoint reports "disconnected").
MONGODB_URI=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- Admin access -----------------------------------------------------------
# Bearer token required for GET /api/projects.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, GET /api/projects responds with 503 (admin access not configured).
ADMIN_API_TOKEN=

# ==============================================================================
# Cynbit Smart Project Discovery & Cost Estimator — Environment Configuration
# ==============================================================================

# Backend Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Local: mongodb://127.0.0.1:27017/cynbit_discovery
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cynbit_discovery?retryWrites=true&w=majority
MONGODB_URI=

# CORS Configuration (Comma-separated allowed frontend origins)
CORS_ORIGIN=http://localhost:5173

# Admin Security Token (for GET /api/projects protected route)
ADMIN_API_TOKEN=dev-admin-secret-change-in-production

# Frontend API URL (leave empty in development if using Vite proxy /api)
# Production example: https://cynbit-discovery-api.onrender.com
VITE_API_URL=

